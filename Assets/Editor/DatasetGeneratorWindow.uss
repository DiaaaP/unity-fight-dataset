.generator-panel {
    padding: 14px;
    flex-grow: 1;
}
.heading {
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}
.state {
    font-size: 13px;
    margin-bottom: 10px;
}
.wrap {
    white-space: normal;
}
.progress {
    height: 24px;
    margin-top: 8px;
    margin-bottom: 8px;
}
.block {
    margin-top: 8px;
    margin-bottom: 8px;
}
.button-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
}
.button-row > Button {
    flex-grow: 1;
    min-width: 100px;
    height: 27px;
    margin-right: 4px;
    margin-bottom: 4px;
}
.hidden {
    display: none;
}
